# Public site configuration — NON-SECRET. NEXT_PUBLIC_* values are inlined into
# the client bundle, so never put secrets here. Read via lib/config.js and used
# for metadata, JSON-LD, sitemap, robots, the OG share card and contact buttons.
#
# Override per-environment in Vercel's dashboard if the domain/email changes.

NEXT_PUBLIC_SITE_URL=https://hrsrobot.co.uk

NEXT_PUBLIC_CONTACT_EMAIL=info@hrsrobot.co.uk

# Web3Forms access key for the /contact form. PUBLIC by design — the form submits
# to Web3Forms directly from the browser (their free plan blocks server-side
# calls), so the key is inlined into the client bundle. It only permits sending
# to the inbox configured for this form in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=0767b190-f1e6-40f8-9bdf-4b0467154112

# Analytics. Vercel Web Analytics needs no key here — it is enabled per-project
# in the Vercel dashboard and runs for every visitor (cookieless, so it is not
# behind the consent banner). The two IDs below are the consent-gated tools.
#
# Two gates apply before either of these tags loads:
#   1. the visitor has accepted cookies, and
#   2. the page is being served from NEXT_PUBLIC_SITE_URL's host.
#
# The second gate is why these IDs can live here safely: localhost and Vercel
# preview deployments never reach the live property, so the numbers only ever
# reflect real visitors. Clearing an ID disables that tool entirely.
#
# GA4 Measurement ID, from Google Analytics → Admin → Data streams (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=G-CM9SZ8031H

# Microsoft Clarity project ID, from Clarity → Settings → Overview.
# Remember to set the project to "cookie consent required" so its own UK/EEA
# enforcement lines up with our banner.
NEXT_PUBLIC_CLARITY_ID=y0qw1x0v8k
